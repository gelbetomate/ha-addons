  {
    "id": "filter_key1",
    "type": "function",
    "z": "tab1",
    "name": "Key 1 Hit Filter",
    "func": "if (msg.payload && msg.payload.key === 1 && msg.payload.action === \"hit\") {\n    return { payload: { page: 2 } };\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 150,
    "wires": [
      [
        "pub_page"
      ]
    ]
  },
