[
  {
    "id": "tab1",
    "type": "tab",
    "label": "u::lux UMP Bridge Flow",
    "disabled": false,
    "info": "Bidirektionale Steuerung und Sensor-Erfassung fuer den u::LuxSwitch über die UMP Bridge"
  },
  {
    "id": "broker1",
    "type": "mqtt-broker",
    "name": "Mosquitto MQTT Broker",
    "broker": "192.168.178.63",
    "port": "1883",
    "clientid": "node-red-ulux",
    "usetls": false,
    "verifyssl": false,
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "sub_events",
    "type": "mqtt in",
    "z": "tab1",
    "name": "u::lux Events Empfangen",
    "topic": "ulux/+/event",
    "qos": "0",
    "datatype": "json",
    "broker": "broker1",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 100,
    "wires": [
      [
        "debug_events",
        "filter_key1"
      ]
    ]
  },
  {
    "id": "sub_sensors",
